{
  "azureDatabase": {
    "server": "elite-shop-server.database.windows.net",
    "database": "EliteShopDB",
    "authentication": "SqlPassword",
    "username": "elite-shop-admin",
    "connectionTimeout": 30,
    "encrypt": true,
    "trustServerCertificate": false,
    "multipleActiveResultSets": false
  },
  "sqlScripts": {
    "setupDatabase": "database-setup.sql",
    "migrateData": "migrate-data.sql"
  },
  "backendIntegration": {
    "apiBaseUrl": "https://elite-shop-api.azurewebsites.net",
    "endpoints": {
      "products": "/api/products",
      "categories": "/api/categories",
      "cart": "/api/cart",
      "auth": "/api/auth",
      "orders": "/api/orders"
    }
  }
}