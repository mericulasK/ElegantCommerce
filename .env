# Database Configuration
# Demo database - replace with your actual Neon Database URL
DATABASE_URL=postgresql://demo:demo@demo.neon.tech/elegantcommerce?sslmode=require

# Session Configuration
SESSION_SECRET=elegantcommerce-super-secret-session-key-2025

# JWT Configuration
JWT_SECRET=elegantcommerce-jwt-secret-key-2025

# Application Configuration
NODE_ENV=production
PORT=3000

# API Configuration
API_BASE_URL=http://localhost:5000/api

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_ENABLE_ANIMATIONS=true

# Development Configuration (for local development)
# Uncomment and configure for local development
# DATABASE_URL=postgresql://postgres:password@localhost:5432/elegantcommerce_dev
# NODE_ENV=development
